{
  "name": "uniform-api-response",
  "version": "1.0.0",
  "description": "One consistent JSON envelope for every API response and error: success, data, error code, request id and pagination. Express-compatible, zero dependencies.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "files": [
