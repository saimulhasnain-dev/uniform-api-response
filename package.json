    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "api",
    "response",
    "envelope",
    "error handling",
    "express",
    "rest",
    "standard",
    "pagination",
    "request id"
  ],
